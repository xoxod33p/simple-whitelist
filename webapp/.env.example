# Copy this file to .env and set DB_PATH to the SAME file your Paper plugin uses.
# That path is printed in the server console on startup, and set in
# plugins/SimpleWhitelist/config.yml as "database-path".
#
# Example if the webapp runs on the same machine as the server:
DB_PATH=../server/plugins/SimpleWhitelist/whitelist.db

# Port the web panel listens on
PORT=3000

# Simple shared-secret login for the panel (change this!)
ADMIN_PASSWORD=deep2003
